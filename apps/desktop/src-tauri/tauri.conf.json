{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corbits Personal Finance",
  "version": "0.6.0",
  "identifier": "com.corbitsdev.macos.personal-finance",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/fin-host"
    ],
    "resources": {
      "../dist": "gui"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGRkFDOTAyQUYxQkNDNDgKUldSSXpCdXZBc242djU5SmttNnY5MmJKUXNBNTQvQ1Q3NWU3K3UyYk9yQWZoUXRxYjdDTkVqdmwK",
      "endpoints": [
        "https://github.com/brianjfox/personal-finance-intx/releases/latest/download/latest.json"
      ]
    }
  }
}
